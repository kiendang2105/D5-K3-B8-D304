# Mẫu biến môi trường — COPY thành .env và điền key thật.
# KHÔNG commit file .env (đã có trong .gitignore).
#
# Prototype hiện chạy hoàn toàn ở client: key nhập qua nút "API key"
# trên header và lưu trong localStorage của trình duyệt.
# File này dành cho bước CP3+ khi tách backend để giấu key.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
